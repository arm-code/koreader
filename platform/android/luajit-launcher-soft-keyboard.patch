diff --git a/app/src/main/java/org/koreader/launcher/SoftKeyboard.kt b/app/src/main/java/org/koreader/launcher/SoftKeyboard.kt
new file mode 100644
index 0000000..2e83259
--- /dev/null
+++ b/app/src/main/java/org/koreader/launcher/SoftKeyboard.kt
@@ -0,0 +1,119 @@
+package org.koreader.launcher
+
+import android.content.Context
+import android.text.InputType
+import android.view.KeyEvent
+import android.view.View
+import android.view.ViewGroup
+import android.view.inputmethod.BaseInputConnection
+import android.view.inputmethod.EditorInfo
+import android.view.inputmethod.InputConnection
+import android.view.inputmethod.InputMethodManager
+import android.widget.FrameLayout
+import java.util.concurrent.ConcurrentLinkedQueue
+
+/* Lets the system on-screen keyboard type into KOReader.
+ *
+ * NativeActivity has no text-editing view, so the system refuses to show its keyboard.
+ * We attach a tiny invisible view that behaves as a text editor and turn what the IME
+ * sends into a queue of operations that lua polls: plain text, '\b' (backspace), '\n' (enter). */
+class SoftKeyboard(private val context: Context) {
+
+    private val pending = ConcurrentLinkedQueue<String>()
+    private var composingLength = 0
+    private var view: ImeView? = null
+
+    private inner class ImeView : View(context) {
+        init {
+            isFocusable = true
+            isFocusableInTouchMode = true
+        }
+
+        override fun onCheckIsTextEditor(): Boolean = true
+
+        override fun onCreateInputConnection(outAttrs: EditorInfo): InputConnection {
+            outAttrs.inputType = InputType.TYPE_CLASS_TEXT or InputType.TYPE_TEXT_FLAG_MULTI_LINE
+            outAttrs.imeOptions = EditorInfo.IME_FLAG_NO_FULLSCREEN or EditorInfo.IME_FLAG_NO_EXTRACT_UI
+            composingLength = 0
+            return Connection(this)
+        }
+    }
+
+    private inner class Connection(target: View) : BaseInputConnection(target, false) {
+        // Replace the text currently being composed by the IME with the new text.
+        private fun replaceComposing(text: CharSequence?) {
+            repeat(composingLength) { pending.add("\b") }
+            composingLength = 0
+            if (!text.isNullOrEmpty()) pending.add(text.toString())
+        }
+
+        override fun setComposingText(text: CharSequence?, newCursorPosition: Int): Boolean {
+            replaceComposing(text)
+            composingLength = text?.length ?: 0
+            return true
+        }
+
+        override fun commitText(text: CharSequence?, newCursorPosition: Int): Boolean {
+            replaceComposing(text)
+            return true
+        }
+
+        override fun finishComposingText(): Boolean {
+            composingLength = 0
+            return true
+        }
+
+        override fun deleteSurroundingText(beforeLength: Int, afterLength: Int): Boolean {
+            if (composingLength > 0) {
+                composingLength = maxOf(0, composingLength - beforeLength)
+            }
+            repeat(beforeLength) { pending.add("\b") }
+            return true
+        }
+
+        override fun sendKeyEvent(event: KeyEvent): Boolean {
+            if (event.action == KeyEvent.ACTION_DOWN) {
+                when (event.keyCode) {
+                    KeyEvent.KEYCODE_DEL -> pending.add("\b")
+                    KeyEvent.KEYCODE_ENTER -> pending.add("\n")
+                    else -> {
+                        val ch = event.unicodeChar
+                        if (ch != 0) pending.add(String(Character.toChars(ch)))
+                    }
+                }
+            }
+            return true
+        }
+    }
+
+    /* Must run on the UI thread. */
+    fun show(activity: android.app.Activity) {
+        val v = view ?: ImeView().also {
+            activity.addContentView(it, FrameLayout.LayoutParams(1, 1))
+            view = it
+        }
+        v.visibility = View.VISIBLE
+        v.requestFocus()
+        val imm = context.getSystemService(Context.INPUT_METHOD_SERVICE) as InputMethodManager
+        imm.restartInput(v)
+        imm.showSoftInput(v, InputMethodManager.SHOW_IMPLICIT)
+    }
+
+    /* Must run on the UI thread. */
+    fun hide() {
+        val v = view ?: return
+        val imm = context.getSystemService(Context.INPUT_METHOD_SERVICE) as InputMethodManager
+        imm.hideSoftInputFromWindow(v.windowToken, 0)
+        composingLength = 0
+        pending.clear()
+    }
+
+    /* Returns and clears what was typed since the last call. */
+    fun poll(): String {
+        val sb = StringBuilder()
+        while (true) {
+            sb.append(pending.poll() ?: break)
+        }
+        return sb.toString()
+    }
+}
